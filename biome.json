{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!src/ipc/bindings", "!src-tauri", "!docs", "!**/*.md", "!pnpm-lock.yaml"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@tauri-apps/*"],
                "message": "Tauri APIs are imported only in src/ipc/transport.ts (ARCHITECTURE §4.5)."
              }
            ]
          }
        }
      },
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["src/ipc/transport.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
