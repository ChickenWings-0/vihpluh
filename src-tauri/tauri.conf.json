{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vihpluh",
  "version": "0.1.0",
  "identifier": "io.github.chickenwings-0.vihpluh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "vihpluh",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 270,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-domain-reliability --no-pings"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: vthumb: http://vthumb.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'",
      "devCsp": "default-src 'self' 'unsafe-inline'; img-src 'self' data: blob: vthumb: http://vthumb.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; object-src 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "A fast, keyboard-driven media player",
    "longDescription": "vihpluh is a compact, keyboard-driven desktop media player built on mpv's playback engine. No telemetry, no accounts, no network traffic unless you open a stream.",
    "homepage": "https://github.com/ChickenWings-0/vihpluh",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "fileAssociations": [
      {
        "ext": [
          "mkv",
          "mk3d"
        ],
        "name": "Matroska video",
        "description": "Matroska video",
        "mimeType": "video/x-matroska",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "m4v"
        ],
        "name": "MPEG-4 video",
        "description": "MPEG-4 video",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": [
          "webm"
        ],
        "name": "WebM video",
        "description": "WebM video",
        "mimeType": "video/webm",
        "role": "Viewer"
      },
      {
        "ext": [
          "avi"
        ],
        "name": "AVI video",
        "description": "AVI video",
        "mimeType": "video/x-msvideo",
        "role": "Viewer"
      },
      {
        "ext": [
          "mov"
        ],
        "name": "QuickTime video",
        "description": "QuickTime video",
        "mimeType": "video/quicktime",
        "role": "Viewer"
      },
      {
        "ext": [
          "ts",
          "m2ts",
          "mts"
        ],
        "name": "MPEG transport stream",
        "description": "MPEG transport stream",
        "mimeType": "video/mp2t",
        "role": "Viewer"
      },
      {
        "ext": [
          "mpg",
          "mpeg"
        ],
        "name": "MPEG video",
        "description": "MPEG video",
        "mimeType": "video/mpeg",
        "role": "Viewer"
      },
      {
        "ext": [
          "wmv"
        ],
        "name": "Windows Media video",
        "description": "Windows Media video",
        "mimeType": "video/x-ms-wmv",
        "role": "Viewer"
      },
      {
        "ext": [
          "flv"
        ],
        "name": "Flash video",
        "description": "Flash video",
        "mimeType": "video/x-flv",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogv"
        ],
        "name": "Ogg video",
        "description": "Ogg video",
        "mimeType": "video/ogg",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 audio",
        "description": "MP3 audio",
        "mimeType": "audio/mpeg",
        "role": "Viewer"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC audio",
        "description": "FLAC audio",
        "mimeType": "audio/flac",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a",
          "aac"
        ],
        "name": "AAC audio",
        "description": "AAC audio",
        "mimeType": "audio/mp4",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogg",
          "oga",
          "opus"
        ],
        "name": "Ogg audio",
        "description": "Ogg audio",
        "mimeType": "audio/ogg",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV audio",
        "description": "WAV audio",
        "mimeType": "audio/x-wav",
        "role": "Viewer"
      },
      {
        "ext": [
          "mka"
        ],
        "name": "Matroska audio",
        "description": "Matroska audio",
        "mimeType": "audio/x-matroska",
        "role": "Viewer"
      },
      {
        "ext": [
          "wma"
        ],
        "name": "Windows Media audio",
        "description": "Windows Media audio",
        "mimeType": "audio/x-ms-wma",
        "role": "Viewer"
      },
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "Playlist",
        "description": "Playlist",
        "mimeType": "audio/x-mpegurl",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "rpm": {
        "depends": [
          "mpv-libs",
          "webkit2gtk4.1",
          "gtk3",
          "libepoxy"
        ]
      }
    }
  }
}
